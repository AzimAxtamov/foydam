# Скопируйте в .env и заполните. Файл .env в git НЕ коммитится (см. .gitignore).
# docker compose -f docker-compose.prod.yml up -d --build

# --- Postgres ---
POSTGRES_USER=sellertools
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=sellertools

# --- Telegram-бот ---
# Токен от @BotFather.
BOT_TOKEN=CHANGE_ME_bot_token

# --- Шифрование ключей селлеров (AES-256) ---
# 32 байта в base64. Сгенерировать: openssl rand -base64 32
CRYPTO_KEY_BASE64=CHANGE_ME_base64_32_bytes

# --- Админ-алерты ---
# Ваш Telegram chat_id (узнать: напишите @userinfobot). 0 — алерты выключены.
ADMIN_CHAT_ID=0

# --- Режим Uzum API: Real (боевой) | Mock (демо-данные) ---
UZUM_API_MODE=Real
