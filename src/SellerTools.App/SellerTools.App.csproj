<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>sellertools-app</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Хост, конфиг, DI -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
    <!-- EF Core + PostgreSQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.*" />
    <!-- Telegram-бот (long polling) -->
    <PackageReference Include="Telegram.Bot" Version="22.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SellerTools.Core\SellerTools.Core.csproj" />
    <ProjectReference Include="..\SellerTools.UzumApi\SellerTools.UzumApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Секреты: копируются в вывод, но не в git (см. .gitignore) -->
    <None Update="appsettings.Secrets.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('appsettings.Secrets.json')" />
  </ItemGroup>

</Project>
