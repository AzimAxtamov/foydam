{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sellertools-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=sellertools;Username=sellertools;Password=sellertools"
  },
  "UzumApi": {
    "Mode": "Mock",
    "BaseUrl": "https://api-seller.uzum.uz/api/seller-openapi/",
    "AuthHeaderName": "Authorization",
    "AuthScheme": "",
    "MaxRetries": 4,
    "RetryBaseDelayMs": 500,
    "PageSize": 100,
    "RequestTimeoutSeconds": 100,
    "ConnectTimeoutSeconds": 15
  },
  "Sync": {
    "//": "Пороги/интервалы синка «синк → Postgres → отчёт из БД». Все — с дефолтами в SyncOptions.",
    "RateLimitDailyFloor": 5000,
    "CardsFreshnessHours": 6,
    "DeltaFreshnessHours": 6,
    "RefreshThrottleMinutes": 30,
    "ProvisionSpacingMinutes": 2,
    "NightlyJitterSeconds": 30
  },
  "Bot": {
    "//": "Токен НЕ хранить здесь. Задать в appsettings.Secrets.json или env Bot__Token.",
    "Token": ""
  },
  "Crypto": {
    "//": "AES-256 ключ в base64 (32 байта). НЕ хранить здесь — appsettings.Secrets.json или env Crypto__KeyBase64.",
    "KeyBase64": ""
  },
  "Admin": {
    "//": "chat_id админа для алертов (env Admin__ChatId). 0 — алерты выключены.",
    "ChatId": 0,
    "ThrottleMinutes": 10
  }
}
